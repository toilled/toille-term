{
  "name": "toille-term",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "oxlint && eslint .",
    "lint:fast": "oxlint",
    "lint:eslint": "eslint .",
    "format": "node scripts/check-format.js --write",
    "format:check": "node scripts/check-format.js",
    "format:all": "prettier --write .",
    "format:check:all": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "fallow:health": "fallow health --baseline .fallow-baseline.json --baseline-mode identity",
    "fallow:baseline": "fallow health --save-baseline .fallow-baseline.json --baseline-mode identity"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0-rc.8",
    "solid-js": "^2.0.0-rc.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^3.0.0-next.27",
    "vitest": "^5.0.0"
  }
}
